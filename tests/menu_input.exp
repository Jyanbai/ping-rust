#!/usr/bin/expect -f
# 运行条件见 tests/menu_input_e2e.rs；不创建、删除或更改节点。
set timeout 30
log_user 1
if {$argc != 3} {
    puts stderr "usage: menu_input.exp <ping-rust> <first-profile-port> <profile-count>"
    exit 2
}
set binary [lindex $argv 0]
set port [lindex $argv 1]
set profile_count [lindex $argv 2]

proc expect_or_fail {pattern stage} {
    expect {
        -re $pattern { return }
        eof { puts stderr "menu ended during $stage"; exit 1 }
        timeout { puts stderr "menu timed out during $stage"; exit 1 }
    }
}
proc send_choice {value} { send -- "$value\r" }
proc main_menu {} { expect_or_fail {请选择 \[0-10\]: } "main menu" }
proc tools_menu {} {
    expect_or_fail {工具:} "tools menu"
    expect_or_fail {请选择 \[0-8\]: } "tools prompt"
}
# 固定完整列表，同时匹配精确名称、连续编号与末尾返回；两条入口共用同一断言。
proc protocol_menu {} {
    expect_or_fail {1\) VLESS-REALITY\r?\n2\) Hysteria2\r?\n3\) Shadowsocks\r?\n4\) VLESS-XHTTP-REALITY\r?\n5\) VLESS-ENC\r?\n6\) NaiveProxy\r?\n7\) AnyTLS\r?\n8\) TUIC\r?\n9\) VLESS-TLS-Vision\r?\n10\) Trojan-TLS\r?\n11\) VLESS-WS-TLS\r?\n12\) Trojan-REALITY\r?\n13\) Snell v3\r?\n14\) VMess-WS-TLS\r?\n15\) SOCKS5\r?\n16\) VLESS-Sudoku\r?\n0\) 返回\r?\n} "complete protocol order and exact names"
    expect_or_fail {请选择 \[0-16\]: } "protocol prompt"
}
proc enter_protocol_menu {advanced} {
    if {$advanced} {
        send_choice 9
        tools_menu
        send_choice 2
    } else {
        send_choice 1
    }
    protocol_menu
}
proc advanced_name_port {slug} {
    expect_or_fail "配置名称（默认：$slug，输入 0 返回）：" "advanced protocol mapping: $slug"
    send_choice "menu-cancel-$slug"
    expect_or_fail {监听端口（默认：443，输入 0 返回）：} "advanced port"
    send_choice 25464
}
proc anytls_modes {} {
    expect_or_fail {AnyTLS 外层安全模式:\r?\n\r?\n1\) TLS\r?\n2\) REALITY\r?\n0\) 返回} "AnyTLS embedded modes without rank labels"
    expect_or_fail {请选择 \[0-2\]: } "AnyTLS modes prompt"
}
proc shadowsocks_modes {advanced} {
    if {$advanced} {
        expect_or_fail {1\) 普通 SS2022\r?\n2\) SS2022 \+ ShadowTLS v3\r?\n0\) 返回} "advanced Shadowsocks modes"
    } else {
        expect_or_fail {1\) Shadowsocks 2022\r?\n2\) Shadowsocks 2022 \+ ShadowTLS v3\r?\n0\) 返回} "fast Shadowsocks modes"
    }
    expect_or_fail {请选择 \[0-2\]: } "Shadowsocks modes prompt"
}
proc choose_profile {} {
    global profile_count
    if {$profile_count > 1} {
        expect_or_fail {请选择配置:} "profile selector"
        expect_or_fail {请选择 \[0-[0-9]+\]: } "profile selection prompt"
        send_choice 1
    }
}
proc change_menu {} {
    expect_or_fail {选择更改项目:} "change menu"
    expect_or_fail {1\) 更改端口\r?\n2\) 更改配置名称} "unchanged change actions"
    expect_or_fail {请选择 \[0-[0-9]+\]: } "change action prompt"
}
proc port_prompt {} {
    global port
    expect_or_fail "输入新端口（输入 r 随机分配）（默认：$port，输入 0 返回）：" "port prompt"
}
proc successful_exit {} {
    expect {
        eof {}
        timeout { puts stderr "EOF did not exit menu"; exit 1 }
    }
    set result [wait]
    if {[lindex $result 2] != 0 || [lindex $result 3] != 0} {
        puts stderr "menu exited unsuccessfully: $result"
        exit 1
    }
}


# Empty input must only repeat the prompt, with no default action or error.
proc empty_stays {max} {
    send_choice ""
    expect {
        -re {无效序号|配置名称|请输入端口} { puts stderr "empty input changed menu"; exit 1 }
        -re [format {请选择 \[0-%s\]: } $max] {}
        eof { exit 1 }
        timeout { exit 1 }
    }
}
proc result_page {} {
    expect_or_fail {按回车返回主菜单\.\.\.} "result page"
    send_choice ""
    main_menu
}
proc back_to_main {advanced} {
    if {$advanced} { tools_menu; send_choice 0 }
    main_menu
}
spawn $binary
expect_or_fail {https://github.com/Jyanbai/ping-rust} "project link"
expect_or_fail {shoes: • (running|stopped|not installed)} "service status"
expect_or_fail "节点 \\($profile_count\\):" "node count"
expect_or_fail "• VLESS-Reality-Vision - 端口: $port" "node protocol and port"
main_menu
empty_stays 10
send_choice abc
expect_or_fail {无效序号！\r?\n请选择 \[0-10\]: } "exact invalid main number"
foreach advanced {0 1} {
    enter_protocol_menu $advanced
    empty_stays 16
    send_choice 17
    expect_or_fail {无效序号！\r?\n请选择 \[0-16\]: } "exact invalid protocol number"
    send_choice 0
    back_to_main $advanced
}
# Keep all protocol numbers and advanced defaults covered; Sudoku has no warning/confirmation.
set slugs {reality hysteria2 shadowsocks vless-xhttp-reality vless-enc naiveproxy anytls tuic vless-tls-vision trojan-tls vless-ws-tls trojan-reality snell vmess-ws-tls socks5 vless-sudoku}
set number 0
foreach slug $slugs {
    incr number
    enter_protocol_menu 1
    send_choice $number
    expect_or_fail "配置名称（默认：$slug，输入 0 返回）：" "advanced mapping $number"
    send_choice 0
    protocol_menu
    send_choice 0
    tools_menu
    send_choice 0
    main_menu
}
# Nested numbered modes return to their protocol selector, then to their parent.
foreach advanced {0 1} {
    enter_protocol_menu $advanced
    send_choice 7
    if {$advanced} { advanced_name_port anytls }
    anytls_modes
    empty_stays 2
    send_choice 3
    expect_or_fail {无效序号！\r?\n请选择 \[0-2\]: } "AnyTLS invalid mode"
    send_choice 0
    protocol_menu
    send_choice 0
    back_to_main $advanced
    foreach mode {1 2} {
        enter_protocol_menu $advanced
        send_choice 7
        if {$advanced} { advanced_name_port anytls }
        anytls_modes
        send_choice $mode
        if {$advanced} {
            expect_or_fail {AnyTLS 用户名（默认：default，输入 0 返回）：} "AnyTLS selected mode"
        } else {
            expect_or_fail {请输入端口（默认：随机，输入 0 返回）：} "AnyTLS selected port"
        }
        send_choice 0
        if {!$advanced} { anytls_modes; send_choice 0 }
        protocol_menu
        send_choice 0
        back_to_main $advanced
    }
}
foreach advanced {0 1} {
    foreach mode {1 2} {
        enter_protocol_menu $advanced
        send_choice 3
        if {$advanced} { advanced_name_port shadowsocks }
        shadowsocks_modes $advanced
        empty_stays 2
        send_choice $mode
        if {!$advanced} {
            expect_or_fail {请输入端口（默认：随机，输入 0 返回）：} "SS port"
            send_choice 25464
            if {$mode == 1} {
                expect_or_fail {1\) aes-128-gcm\r?\n2\) aes-256-gcm\r?\n3\) chacha20-ietf-poly1305\r?\n4\) 2022-blake3-aes-128-gcm\r?\n5\) 2022-blake3-aes-256-gcm\r?\n6\) 2022-blake3-chacha20-ietf-poly1305\r?\n0\) 返回} "all fast SS ciphers"
                set count 6
            } else {
                expect_or_fail {1\) 2022-blake3-aes-128-gcm\r?\n2\) 2022-blake3-aes-256-gcm\r?\n3\) 2022-blake3-chacha20-ietf-poly1305\r?\n0\) 返回} "fast ShadowTLS ciphers"
                set count 3
            }
        } else {
            expect_or_fail {1\) 2022-blake3-aes-256-gcm\r?\n2\) 2022-blake3-aes-128-gcm\r?\n3\) 2022-blake3-chacha20-ietf-poly1305} "advanced SS2022 ciphers"
            if {$mode == 1} {
                expect_or_fail {4\) aes-256-gcm\r?\n5\) aes-128-gcm\r?\n6\) chacha20-ietf-poly1305\r?\n0\) 返回} "all advanced SS ciphers"
                set count 6
            } else { set count 3 }
        }
        expect_or_fail [format {请选择 \[0-%s\]: } $count] "cipher prompt"
        empty_stays $count
        send_choice 0
        if {!$advanced} { shadowsocks_modes 0; send_choice 0 }
        protocol_menu
        send_choice 0
        back_to_main $advanced
    }
}
foreach advanced {0 1} {
    enter_protocol_menu $advanced
    send_choice 5
    if {$advanced} { advanced_name_port vless-enc } else {
        expect_or_fail {请输入端口（默认：随机，输入 0 返回）：} "ENC port"
        send_choice 25464
    }
    expect_or_fail {请选择 \[0-3\]: } "ENC mode"
    empty_stays 3
    send_choice 1
    expect_or_fail {请选择 \[0-2\]: } "ENC auth"
    empty_stays 2
    send_choice 0
    expect_or_fail {请选择 \[0-3\]: } "auth returns to mode"
    send_choice 1
    expect_or_fail {请选择 \[0-2\]: } "auth again"
    send_choice 1
    expect_or_fail {开启 Vision？ \[y/N\]（输入 0 返回）：} "Vision"
    send_choice 0
    expect_or_fail {请选择 \[0-2\]: } "Vision returns to auth"
    send_choice 1
    expect_or_fail {开启 Vision？ \[y/N\]（输入 0 返回）：} "Vision again"
    send_choice ""
    expect_or_fail {启用 Sudoku 外观？ \[y/N\]（输入 0 返回）：} "Sudoku without cost warning"
    send_choice 0
    expect_or_fail {开启 Vision？ \[y/N\]（输入 0 返回）：} "Sudoku returns to Vision"
    send_choice 0
    expect_or_fail {请选择 \[0-2\]: } "back to auth"
    send_choice 0
    expect_or_fail {请选择 \[0-3\]: } "back to mode"
    send_choice 0
    protocol_menu
    send_choice 0
    back_to_main $advanced
}
# Fast Sudoku now proceeds directly to its normal parameters, without substitute confirmation.
enter_protocol_menu 0
send_choice 16
expect_or_fail {请输入端口（默认：随机，输入 0 返回）：} "Sudoku direct port"
send_choice 0
protocol_menu
send_choice 0
main_menu
# Change text validation and 0 return remain non-mutating.
send_choice 2
choose_profile
change_menu
send_choice 1
port_prompt
send_choice 65536
expect_or_fail {错误！请输入 1 到 65535、r 或 0} "port validation kept"
port_prompt
send_choice 0
change_menu
send_choice 2
expect_or_fail {新配置名称（默认：[^\r\n]+，输入 0 返回）：} "rename"
send_choice 0
change_menu
send_choice 0
main_menu
# Delete defaults to no; all bytes checked by the Rust harness after exit.
send_choice 4
choose_profile
expect_or_fail {确认删除 [^\r\n]+？ \[y/N\]（输入 0 返回）：} "delete confirmation retained"
send_choice ""
result_page
# Successful view/help return via one result page and keep the process alive.
send_choice 3
choose_profile
result_page
send_choice 10
result_page
send_choice 9
tools_menu
send_choice 3
expect_or_fail {输入 SNI 域名，空格分隔[^\r\n]*（输入 0 返回）：} "SNI input"
send_choice 0
tools_menu
send_choice 0
main_menu
send_choice 8
expect_or_fail {请选择 \[0-8\]: } "chain menu"
send_choice 8
result_page
send -- "\004"
successful_exit
# EOF at all menu and text depths remains a normal exit.
foreach advanced {0 1} {
    spawn $binary
    main_menu
    enter_protocol_menu $advanced
    send -- "\004"
    successful_exit
}
spawn $binary
main_menu
send_choice 2
choose_profile
change_menu
send_choice 2
expect_or_fail {新配置名称（默认：[^\r\n]+，输入 0 返回）：} "rename EOF"
send -- "\004"
successful_exit
spawn $binary
main_menu
send_choice 2
choose_profile
change_menu
send_choice 2
expect_or_fail {新配置名称（默认：[^\r\n]+，输入 0 返回）：} "rename Ctrl+C"
send -- "\003"
expect_or_fail {\x1b\[\?25h\r?\n} "cursor restoration"
expect eof
set result [wait]
if {[lindex $result 2] != 0 || [lindex $result 3] != 130} { exit 1 }
