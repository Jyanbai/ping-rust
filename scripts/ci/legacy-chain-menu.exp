#!/usr/bin/expect -f

set timeout 180
log_user 1
set binary [lindex $argv 0]
set reality_uri [lindex $argv 1]

proc wait_for {pattern stage} {
    expect {
        -re $pattern { return }
        eof { puts stderr "legacy Chain menu ended during $stage"; exit 1 }
        timeout { puts stderr "legacy Chain menu timed out during $stage"; exit 1 }
    }
}

proc choice {value} { send -- "$value\r" }

spawn $binary
wait_for {请选择 \[0-10\]} "main menu"
choice 9
wait_for {请选择 \[0-9\]} "operations menu"
choice 1
wait_for {Chain Proxy 2\.0} "chain menu"

# Import the generated Reality node into the Chain node inventory. The old
# release does not automatically expose ordinary profiles as Chain nodes.
choice 1
wait_for {节点管理} "node management"
choice 1
wait_for {粘贴分享链接} "share link"
choice $reality_uri
wait_for {节点名称} "node name"
choice "legacy-reality-hop"
wait_for {节点管理} "node creation"
choice 0
wait_for {Chain Proxy 2\.0} "chain menu after node"

# Create one Chain 2.0 definition from the first generated node.
choice 3
wait_for {Chain 管理：} "Chain management"
choice 1
wait_for {Chain 名称} "Chain name"
choice "legacy-chain"
wait_for {按顺序输入 hop} "Chain hop list"
choice 1
wait_for {Chain 管理：} "Chain creation"
choice 0
wait_for {Chain Proxy 2\.0} "chain menu after creation"

# Add the legacy scalar wildcard rule and route it through that Chain.
choice 4
wait_for {路由规则：} "rule management"
choice 1
wait_for {规则名称} "rule name"
choice "legacy-wildcard"
wait_for {Masks} "rule masks"
choice "*.example.test"
wait_for {路由动作} "rule target"
choice 3
wait_for {选择 Chain} "rule Chain target"
choice 1
wait_for {路由规则：} "rule creation"
choice 0
wait_for {Chain Proxy 2\.0} "chain menu after rule"

# Enable Chain Proxy 2.0 so the rule is present in the managed config.
choice 6
wait_for {状态：启用} "Chain enable"
choice 0
wait_for {请选择 \[0-10\]} "return to main menu"
choice 0
wait_for {已退出} "exit"
expect eof
